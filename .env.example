# Copy to .env (gitignored). Placeholder names only; never commit real values.
# Names are provisional until the server exists (Phase 2); update this file when they change.

# Shared admin passphrase (one for both admins)
ADMIN_PASSPHRASE=change-me

# Server port
PORT=3000

# Deploy target (Mac -> Pi)
PI_HOST=hello-party.local
PI_USER=pi

# Home Wi-Fi details. Set only in .env on the Pi, never in git.
WIFI_SSID=
WIFI_PASSWORD=
