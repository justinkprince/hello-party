# Copy to .env (gitignored). Placeholder names only; never commit real values.
# Names are provisional until the server exists (Phase 2); update this file when they change.

# Shared admin passphrase (one for both admins)
ADMIN_PASSPHRASE=change-me

# Secret used to sign admin session tokens (long random string)
ADMIN_TOKEN_SECRET=change-me

# Local-only token shared by the display kiosk, the pad service, and the debug panel
DISPLAY_TOKEN=change-me

# Key in the shared tablet's private URL; grants the shared-device profile kind
SHARED_TABLET_KEY=change-me

# Server port
PORT=3000

# Deploy target (Mac -> Pi), read by scripts/deploy.sh and scripts/health-check.sh.
# Use the Pi's IP address, not hello-party.local (Android does not resolve .local).
# Required: the scripts stop with a message if these are empty.
PI_HOST=
PI_USER=
# Optional: the repo folder on the Pi, relative to its home (default: hello-party)
PI_REPO_DIR=

# Home Wi-Fi details. Set only in .env on the Pi, never in git.
WIFI_SSID=
WIFI_PASSWORD=
